# ============================================================================
# TokenPact — example environment file
# Copy to `.env` and fill in real values.  NEVER commit your real .env.
# ============================================================================

# ---- Orchestrator (escrow lifecycle + settlement coordinator) --------------
ORCHESTRATOR_PORT=8402
ORCHESTRATOR_URL=http://localhost:8402

# ---- Verifier service (sandboxed test runner) ------------------------------
VERIFIER_PORT=8403
VERIFIER_URL=http://localhost:8403
# Sandbox backend the verifier uses to execute untrusted provider output.
# One of: docker | firecracker | none  (use `none` only for trusted local dev)
SANDBOX_DRIVER=docker
# Hard limits applied to every verification run
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_LIMIT=1

# ---- x402 payment rail -----------------------------------------------------
# Network for settlement. Prototype uses a testnet; mainnet is opt-in.
# One of: base-sepolia | base
X402_NETWORK=base-sepolia
# Facilitator that verifies + settles x402 payments (Coinbase runs a public
# one; you can also run your own). See docs/architecture.md.
X402_FACILITATOR_URL=https://x402.org/facilitator
# Stablecoin used for payment (USDC contract on the chosen network)
X402_ASSET=USDC

# ---- Wallets (use burner / testnet keys only in development) ----------------
# The buyer agent funds escrow from this account.
BUYER_PRIVATE_KEY=0xyour_testnet_private_key_here
# The provider agent receives released funds at this address.
PROVIDER_ADDRESS=0xyour_provider_address_here
# The escrow account that holds funds until verification settles.
# In the prototype this is an orchestrator-controlled account; on-chain
# escrow contract settlement is planned (see roadmap).
ESCROW_ADDRESS=0xyour_escrow_address_here

# ---- State / persistence ---------------------------------------------------
# Transaction log. Prototype defaults to a local SQLite file.
DATABASE_URL=file:./data/tokenpact.sqlite

# ---- Misc ------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
